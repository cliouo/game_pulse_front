# 环境配置模板
#
# .env              - 公共配置（所有环境共用）
# .env.development  - 本地开发环境
# .env.test         - 测试环境
# .env.production   - 生产环境
#
# 加载顺序: .env -> .env.[mode]，后者覆盖前者

# ========== 公共配置 (.env) ==========
VITE_APP_NAME=GamePulse
VITE_APP_VERSION=1.0.0

# ========== 环境特定配置 (.env.[mode]) ==========
# API 服务器地址
VITE_API_BASE_URL=http://localhost:8080/api/v1

# 环境标识 (development / test / production)
VITE_APP_ENV=development
